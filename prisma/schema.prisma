generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  preferences UserPreferences?
  aiUsages    AiUsage[]
  id          String             @id @default(cuid())
  email       String             @unique
  name        String?
  prospects   Prospect[]
  templates   ReminderTemplate[]
  approvals   Reminder[]         @relation("ReminderApprovedBy")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Prospect {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  company   String?
  status    ProspectStatus @default(NEW)
  quotes    Quote[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

model Quote {
  id           String      @id @default(cuid())
  prospectId   String
  prospect     Prospect    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  quoteNumber  String?
  title        String
  amount       Decimal?
  currency     String      @default("EUR")
  status       QuoteStatus @default(DRAFT)
  validUntil   DateTime?
  legalNotice  String?
  paymentTerms String?
  sentAt       DateTime?
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  reminders    Reminder[]
  lines        QuoteLine[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([prospectId])
  @@index([status])
}

model QuoteLine {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quoteId])
}

model Reminder {
  iteration             Int               @default(1)
  generatedByAi         Boolean           @default(false)
  aiModel               String?
  aiPromptVersion       String?
  id                    String            @id @default(cuid())
  quoteId               String
  quote                 Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  templateId            String?
  template              ReminderTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  approvedById          String?
  approvedBy            User?             @relation("ReminderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  subject               String
  body                  String
  status                ReminderStatus    @default(DRAFT)
  requiresHumanApproval Boolean           @default(true)
  approvedAt            DateTime?
  scheduledAt           DateTime?
  sentAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([quoteId])
  @@index([templateId])
  @@index([approvedById])
  @@index([status])
}

model ReminderTemplate {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  subject   String
  body      String
  status    TemplateStatus @default(ACTIVE)
  reminders Reminder[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([status])
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ReminderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum TemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model UserPreferences {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName   String?
  logoUrl        String?
  companyAddress String?
  companyPhone   String?
  companyEmail   String?
  companyWebsite String?
  trade          Trade?
  defaultTone    ReminderTone @default(PROFESSIONAL)
  signatureBlock String?
  quoteFooter    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  inputTokens  Int
  outputTokens Int
  costEur      Decimal  @db.Decimal(10, 6)
  reminderId   String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

enum Trade {
  PLOMBIER
  ELECTRICIEN
  MACON
  CARRELEUR
  MENUISIER
  PEINTRE
  PAYSAGISTE
  CHAUFFAGISTE
  COUVREUR
  AUTRE
}

enum ReminderTone {
  FORMAL
  PROFESSIONAL
  FRIENDLY
  DIRECT
}
